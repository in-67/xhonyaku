{
  "manifest_version": 3,
  "name": "X 英語自動日本語翻訳",
  "version": "1.2",
  "description": "ツイート内の英語を自動で日本語に翻訳（Ollama使用）",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
